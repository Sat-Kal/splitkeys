<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Key.Accent" parent="Key">
        <item name="android:background">@drawable/key_bg_accent</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="Key.Function" parent="Key">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Key.Delete" parent="Key">
        <item name="android:background">@drawable/key_bg_accent</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="Key.Space" parent="Key">
        <item name="android:background">@drawable/space_bg</item>
    </style>

    <style name="Key.Emoji" parent="Key">
        <item name="android:textSize">26dp</item>
    </style>
</resources>
